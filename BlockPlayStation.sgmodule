#!name=ps拦截系统更新及游戏更新
#!desc=ps拦截系统更新及游戏更新
[Rule]
# 拦截 PlayStation 下载
DOMAIN-KEYWORD,dl.playstation,REJECT,extended-matching
# 拦截 PlayStation 更新
DOMAIN-KEYWORD,update.playstation,REJECT,extended-matching
#DOMAIN-KEYWORD,playstation,REJECT,extended-matching

AND,SRC-IP,192.168.1.89,DOMAIN-SUFFIX,youtube.com,REJECT,extended-matching
AND,SRC-IP,192.168.1.89,DOMAIN-SUFFIX,youtubei.googleapis.com,REJECT,extended-matching
